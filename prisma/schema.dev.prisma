// LXAuth development schema — SQLite.
//
// The same 16 models as `schema.prisma`, with three differences that are all
// consequences of the provider rather than choices:
//
//   1. `provider = "sqlite"`. It has to be a literal, which is why
//      `prisma.config.ts` chooses between two schema files.
//   2. No `@db.VarChar(n)` annotations. SQLite ignores length limits, and
//      carrying them would imply a guarantee the dev database does not make.
//   3. No enums and no CHECK constraints — SQLite has neither. The enum values
//      are validated in `src/lib/enums.ts` instead, and the CHECK constraints
//      exist only in the Postgres migration.
//
// Two things do carry over unchanged, which is worth stating because it is what
// makes dev worth trusting:
//   * `@default(autoincrement())` covers the spec's SERIAL columns.
//   * Partial indexes are supported, so the single-owner invariant is
//     enforceable in dev too — see `prisma/dev-invariant.sql`.
//
// Keep this file and `schema.prisma` in step. A column added to one and not the
// other fails at runtime in dev, not at build time.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

// --- The 11 specified tables -----------------------------------------------

model accounts {
  id        Int      @id @default(autoincrement())
  type      String   @default("user")
  status    String   @default("active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @map("updated_at")

  properties          account_properties?
  emails              account_emails[]
  addresses           account_addresses[]
  wallets             wallets[]
  memberships         account_memberships[]
  orgMemberships      organization_members[] @relation("member")
  ownedOrganizations  organization_members[] @relation("organization")
  organizationTeams   organization_teams[]
  teamMemberships     organization_team_members[]
  credentials         account_credentials?
  refreshTokens       refresh_tokens[]
  invitesCreated      organization_invites[] @relation("inviter")
  organizationInvites organization_invites[] @relation("inviteOrg")

  @@map("accounts")
}

model account_properties {
  accountId   Int      @id @map("account_id")
  nameId      String   @unique @map("name_id")
  nameDisplay String   @map("name_display")
  avatarUrl   String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @map("updated_at")

  account accounts @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@map("account_properties")
}

model account_emails {
  id         Int      @id @default(autoincrement())
  accountId  Int?     @map("account_id")
  email      String   @unique
  isPrimary  Boolean  @default(false) @map("is_primary")
  isVerified Boolean  @default(false) @map("is_verified")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @default(now()) @map("updated_at")

  account       accounts?                      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  verifications account_email_verifications[]

  @@index([accountId])
  @@map("account_emails")
}

model account_addresses {
  id         Int      @id @default(autoincrement())
  accountId  Int?     @map("account_id")
  address    String
  isPrimary  Boolean  @default(false) @map("is_primary")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @default(now()) @map("updated_at")

  account accounts? @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@map("account_addresses")
}

model wallets {
  id            Int      @id @default(autoincrement())
  accountId     Int?     @map("account_id")
  walletAddress String   @unique @map("wallet_address")
  chain         String   @default("ethereum")
  isPrimary     Boolean  @default(false) @map("is_primary")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @default(now()) @map("updated_at")

  account accounts? @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@map("wallets")
}

model account_memberships {
  id        Int       @id @default(autoincrement())
  accountId Int?      @map("account_id")
  tier      String    @default("free")
  timeStart DateTime  @default(now()) @map("time_start")
  timeEnd   DateTime? @map("time_end")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @map("updated_at")

  account accounts? @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@map("account_memberships")
}

model organization_members {
  organizationId Int      @map("organization_id")
  userId         Int      @map("user_id")
  role           String   @default("member")
  joinedAt       DateTime @default(now()) @map("joined_at")

  organization accounts @relation("organization", fields: [organizationId], references: [id], onDelete: Cascade)
  user         accounts @relation("member", fields: [userId], references: [id], onDelete: Cascade)

  @@id([organizationId, userId])
  @@index([userId])
  @@map("organization_members")
}

model organization_teams {
  id             Int      @id @default(autoincrement())
  organizationId Int?     @map("organization_id")
  name           String
  description    String?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @default(now()) @map("updated_at")

  organization accounts?                   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members      organization_team_members[]

  @@index([organizationId])
  @@map("organization_teams")
}

model organization_team_members {
  teamId   Int      @map("team_id")
  userId   Int      @map("user_id")
  role     String   @default("member")
  joinedAt DateTime @default(now()) @map("joined_at")

  team organization_teams @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user accounts           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([teamId, userId])
  @@index([userId])
  @@map("organization_team_members")
}

// --- The 5 additive tables -------------------------------------------------

model account_credentials {
  accountId         Int      @id @map("account_id")
  passwordHash      String   @map("password_hash")
  passwordChangedAt DateTime @default(now()) @map("password_changed_at")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @default(now()) @map("updated_at")

  account accounts @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@map("account_credentials")
}

model refresh_tokens {
  id         String    @id @default(cuid())
  accountId  Int       @map("account_id")
  tokenHash  String    @unique @map("token_hash")
  familyId   String    @map("family_id")
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  replacedBy String?   @map("replaced_by")
  createdAt  DateTime  @default(now()) @map("created_at")

  account accounts @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([familyId])
  @@map("refresh_tokens")
}

model organization_invites {
  id             Int       @id @default(autoincrement())
  organizationId Int       @map("organization_id")
  email          String
  role           String    @default("member")
  tokenHash      String    @unique @map("token_hash")
  invitedById    Int?      @map("invited_by_id")
  expiresAt      DateTime  @map("expires_at")
  acceptedAt     DateTime? @map("accepted_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  organization accounts  @relation("inviteOrg", fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy   accounts? @relation("inviter", fields: [invitedById], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([email])
  @@map("organization_invites")
}

model account_email_verifications {
  id        Int      @id @default(autoincrement())
  tokenHash String   @unique @map("token_hash")
  emailId   Int      @map("email_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  email account_emails @relation(fields: [emailId], references: [id], onDelete: Cascade)

  @@index([emailId])
  @@map("account_email_verifications")
}

model web3_nonces {
  nonce      String    @id
  accountId  Int?      @map("account_id")
  chain      String    @default("ethereum")
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([accountId])
  @@index([expiresAt])
  @@map("web3_nonces")
}

# ---------------------------------------------------------------------------
# LXAuth server — copy to .env and fill in. Values starting with "your_" are
# placeholders and are treated as unset.
# ---------------------------------------------------------------------------

NODE_ENV=production
HOST=0.0.0.0
PORT=3000

# Public URL of this server, used to build OAuth callback URLs.
PUBLIC_BASE_URL=http://localhost:3000

# PostgreSQL connection string.
DATABASE_URL=postgres://lxauth:your_database_password@localhost:5432/lxauth

# Number of reverse proxies in front of this server (0 = none). Used to read
# the real client IP for rate limiting and audit events.
TRUST_PROXY=0

# Session lifetime in hours, and the maximum active sessions per account.
SESSION_TTL_HOURS=720
MAX_SESSIONS_PER_ACCOUNT=50

# Failed logins before an account is temporarily locked, and for how long.
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# ---------------------------------------------------------------------------
# Optional providers. Leave as-is (or delete) to run with email accounts only.
# ---------------------------------------------------------------------------

# GitHub OAuth app — callback: {PUBLIC_BASE_URL}/api/v1/connections/github/callback
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# GitLab OAuth application — callback: {PUBLIC_BASE_URL}/api/v1/connections/gitlab/callback
GITLAB_CLIENT_ID=your_gitlab_client_id
GITLAB_CLIENT_SECRET=your_gitlab_client_secret
# Self-managed GitLab: change to your instance URL.
GITLAB_BASE_URL=https://gitlab.com

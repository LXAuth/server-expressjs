# LXAuth backend — example environment
#
# Copy to .env and fill in. .env is gitignored; this file is committed, so it
# carries no real values.

# --- Mode -------------------------------------------------------------------
# Production is opt-in. Only the exact string "true" is production — unset,
# empty, "false", "1", or "yes" all mean development. That direction is
# deliberate: a missing variable cannot silently point production code at a
# SQLite file.
PROD=false

# --- Database ---------------------------------------------------------------
# Required in production. In development the SQLite file at prisma/dev.db is
# used instead and this value is ignored.
DATABASE_URL="postgresql://lxauth:lxauth@localhost:5432/lxauth?schema=public"

# --- Server -----------------------------------------------------------------
PORT=3000
HOST=0.0.0.0

# --- Tokens -----------------------------------------------------------------
# Required in production, both of them. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# The access secret signs tokens the verify-token endpoint hands to internal
# microservices, so it must be identical across every service in the fleet.
JWT_ACCESS_SECRET="dev-only-access-secret-change-me"
JWT_REFRESH_SECRET="dev-only-refresh-secret-change-me"

ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=2592000

# Used to derive the hash of refresh, invite, and email-verification tokens.
# Rotating it invalidates every outstanding session.
TOKEN_PEPPER="dev-only-pepper-change-me"

# --- Passwords --------------------------------------------------------------
# argon2 parameters. The defaults below are the OWASP baseline for argon2id.
ARGON2_MEMORY_COST=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

# --- Tokens used in outgoing flows -----------------------------------------
# Base URL for links in verification and invite emails. No mail is sent in this
# build — the token is returned in the response so a client can exercise it.
APP_BASE_URL=http://localhost:3000

# --- Web3 -------------------------------------------------------------------
# The domain embedded in the message a wallet is asked to sign. It must match what
# the client believes it is talking to: the signature is only replay-proof because
# the domain is part of the signed text.
WEB3_DOMAIN=lxauth.local

# How long a login or bind challenge stays valid. Five minutes is about one wallet
# prompt.
WEB3_NONCE_TTL=300

# NOTE: signature verification needs a secp256k1 implementation, and none is
# installed — the build environment has no network access, so ethers or
# @noble/curves could not be added. Until one is installed and wired into
# setRecoveryFn() in src/lib/signature.ts, the web3 endpoints answer 503
# signature_unavailable. See the task record for what to do.

# --- Logging ----------------------------------------------------------------
# debug | info | warn | error
LOG_LEVEL=info

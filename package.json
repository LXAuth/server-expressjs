{
  "name": "lxauth-server",
  "version": "0.1.0",
  "private": true,
  "description": "Zero-trust central account server: one account registry for any number of client applications.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "audit": "npm audit --audit-level=low",
    "migrate": "node dist/migrate.js",
    "migrate:dev": "tsx --env-file-if-exists=.env src/migrate.ts"
  },
  "dependencies": {
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "argon2": "^0.45.2",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "viem": "^2.57.19",
    "vitest": "^5.1.0"
  }
}
